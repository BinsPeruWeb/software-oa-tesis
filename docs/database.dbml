Project software_oa {
  database_type: 'PostgreSQL'
  Note: 'Modelo lógico de la plataforma OA. Los campos cipher almacenan datos cifrados y los campos hmac permiten búsqueda exacta.'
}

Enum role_code {
  ADMIN
  CLINICIAN
}

Enum episode_status {
  OPEN
  CLOSED
}

Enum asset_kind {
  RADIOGRAPH
  GRADCAM
  REPORT
}

Enum study_source_type {
  DICOM_BILATERAL
  RASTER_BILATERAL
  RASTER_SINGLE_ROI
}

Enum knee_side {
  L
  R
}

Enum inference_job_type {
  KL
  GRADCAM
}

Enum inference_job_status {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

Enum review_decision {
  CONFIRMED
  CORRECTED
  REJECTED
}

Enum preflight_file_kind {
  DICOM
  RASTER
}

Enum preflight_status {
  ACCEPTED
  REJECTED
  REVIEW_REQUIRED
  UNAVAILABLE
}

Enum image_layout {
  bilateral
  single
  uncertain
}

Enum report_type {
  EPISODE
  LONGITUDINAL
}

Table schema_migrations {
  name text [pk]
  applied_at timestamptz [not null, default: `now()`]
}

Table roles {
  code role_code [pk]
  description text [not null]

  Note: 'Catálogo fijo con los roles ADMIN y CLINICIAN.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email citext [not null, unique]
  display_name text [not null]
  password_hash text [not null]
  role_code role_code [not null]
  active boolean [not null, default: true]
  failed_attempts integer [not null, default: 0]
  locked_until timestamptz
  professional_license text [note: 'Número de CMP para usuarios médicos.']
  specialty text [note: 'Campo heredado; ya no se solicita en la interfaz.']
  clinician_dni_cipher bytea
  clinician_dni_hmac char(64) [unique]
  health_establishment text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (role_code, active, created_at) [name: 'idx_users_role_active']
  }
}

Table mfa_credentials {
  user_id uuid [pk]
  secret_cipher bytea [not null]
  enabled boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  verified_at timestamptz
}

Table sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]
}

Table patients {
  id uuid [pk, default: `gen_random_uuid()`]
  medical_record_cipher bytea [not null]
  medical_record_hmac char(64) [not null, unique]
  dni_cipher bytea [not null]
  dni_hmac char(64) [not null, unique]
  names_cipher bytea [not null]
  surnames_cipher bytea [not null]
  birth_date_cipher bytea [not null]
  sex_cipher bytea
  created_by uuid [not null]
  owner_clinician_id uuid [not null]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_clinician_id, created_at) [name: 'idx_patients_owner_active', note: 'Índice parcial para pacientes no archivados.']
  }
}

Table patient_contacts {
  patient_id uuid [pk]
  phone_cipher bytea [not null]
  email_cipher bytea
}

Table patient_clinical_profiles {
  patient_id uuid [pk]
  pain_score numeric [note: 'Valor opcional entre 0 y 10.']
  obesity boolean [not null]
  diabetes boolean [not null]
  hypertension boolean [not null]
  nicotine_use boolean [not null]
  trauma_lower_extremity boolean [not null]
  updated_by uuid [not null]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    updated_at [name: 'idx_patient_profile_updated']
  }
}

Table clinical_episodes {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  opened_at date [not null]
  status episode_status [not null, default: 'OPEN']
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (patient_id, opened_at) [name: 'idx_episode_patient']
  }
}

Table stored_assets {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  kind asset_kind [not null]
  storage_key text [not null, unique]
  content_type text [not null]
  original_name_cipher bytea
  plaintext_sha256 char(64) [not null]
  size_bytes bigint [not null, note: 'Mayor que cero.']
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Referencia archivos cifrados de radiografías, Grad-CAM y reportes.'
}

Table image_preflight_reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  input_hash char(64) [not null]
  file_kind preflight_file_kind [not null]
  media_type text [not null, note: 'application/dicom, image/png o image/jpeg.']
  review_status preflight_status [not null]
  suggested_layout image_layout [not null]
  supported boolean [not null]
  provider_model text [not null]
  provider_request_id text
  cost_usd numeric(12,8)
  assessment jsonb
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, default: `now() + interval '30 minutes'`]

  indexes {
    (input_hash, created_by, expires_at) [name: 'idx_preflight_hash_user']
  }
}

Table radiographic_studies {
  id uuid [pk, default: `gen_random_uuid()`]
  episode_id uuid [not null]
  asset_id uuid [not null]
  preflight_id uuid
  exam_date date [not null]
  source_type study_source_type [not null]
  projection_confirmed boolean [not null]
  weight_bearing_confirmed boolean [not null]
  orientation_confirmed boolean [not null]
  metadata_inverted boolean [not null, default: false]
  horizontal_flip boolean [not null, default: false]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table knee_observations {
  id uuid [pk, default: `gen_random_uuid()`]
  study_id uuid [not null]
  knee_side knee_side [not null]

  indexes {
    (study_id, knee_side) [unique]
  }
}

Table inference_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  observation_id uuid [not null]
  job_type inference_job_type [not null]
  status inference_job_status [not null, default: 'QUEUED']
  idempotency_key text [not null, unique]
  attempts integer [not null, default: 0]
  error_code text
  correlation_id uuid [not null, default: `gen_random_uuid()`]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  finished_at timestamptz

  indexes {
    (status, created_at) [name: 'idx_jobs_claim']
  }
}

Table model_predictions {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [unique]
  observation_id uuid [not null]
  model_name text [not null]
  model_version text [not null]
  artifact_hashes jsonb [not null]
  input_hash char(64) [not null]
  input_source text [not null]
  knee_side knee_side [not null]
  probabilities jsonb [not null]
  threshold double
  screen_positive boolean
  kl_origin text
  latency_ms double
  device text [not null]
  correlation_id uuid [not null]
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table gradcam_explanations {
  id uuid [pk, default: `gen_random_uuid()`]
  prediction_id uuid [not null]
  backbone text [not null]
  asset_id uuid [not null]
  target_kl smallint [not null, note: 'Valor entre 0 y 4.']

  indexes {
    (prediction_id, backbone) [unique]
  }
}

Table clinician_reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  prediction_id uuid [not null]
  decision review_decision [not null]
  confirmed_kl smallint [note: 'Valor entre 0 y 4; nulo cuando se rechaza.']
  reason text
  reviewed_by uuid [not null]
  reviewed_at timestamptz [not null, default: `now()`]
}

Table clinical_observations {
  id uuid [pk, default: `gen_random_uuid()`]
  knee_observation_id uuid [not null, unique]
  pain_score numeric [note: 'Valor opcional entre 0 y 10.']
  obesity boolean [not null]
  diabetes boolean [not null]
  hypertension boolean [not null]
  nicotine_use boolean [not null]
  trauma_lower_extremity boolean [not null]
  recorded_by uuid [not null]
  recorded_at timestamptz [not null, default: `now()`]
}

Table prior_exams {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  knee_side knee_side [not null]
  exam_date date [not null]
  confirmed_kl smallint [not null, note: 'Valor entre 0 y 4.']
  pain_score numeric [note: 'Valor opcional entre 0 y 10.']
  obesity boolean [not null]
  diabetes boolean [not null]
  hypertension boolean [not null]
  nicotine_use boolean [not null]
  trauma_lower_extremity boolean [not null]
  recorded_by uuid [not null]

  indexes {
    (patient_id, knee_side, exam_date) [unique, name: 'idx_prior_patient_knee']
  }
}

Table draft_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  episode_id uuid [not null]
  asset_id uuid [not null]
  status text [not null, default: 'DRAFT', note: 'Valor fijo DRAFT.']
  report_type report_type [not null, default: 'EPISODE']
  generated_by uuid [not null]
  generated_at timestamptz [not null, default: `now()`]
}

Table audit_events {
  id bigserial [pk]
  actor_id uuid
  action text [not null]
  entity_type text [not null]
  entity_id text
  correlation_id uuid
  metadata jsonb [not null, default: `'{}'::jsonb`]
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, occurred_at) [name: 'idx_audit_entity']
  }

  Note: 'Tabla append-only protegida por trigger contra UPDATE y DELETE.'
}

Table app_settings {
  key text [pk]
  value jsonb [not null]
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]
}

Ref: roles.code < users.role_code
Ref: users.id - mfa_credentials.user_id [delete: cascade]
Ref: users.id < sessions.user_id [delete: cascade]
Ref: users.id < patients.created_by
Ref: users.id < patients.owner_clinician_id
Ref: patients.id - patient_contacts.patient_id [delete: cascade]
Ref: patients.id - patient_clinical_profiles.patient_id [delete: cascade]
Ref: users.id < patient_clinical_profiles.updated_by
Ref: patients.id < clinical_episodes.patient_id
Ref: users.id < clinical_episodes.created_by
Ref: patients.id < stored_assets.patient_id
Ref: users.id < stored_assets.created_by
Ref: users.id < image_preflight_reviews.created_by
Ref: clinical_episodes.id < radiographic_studies.episode_id [delete: cascade]
Ref: stored_assets.id < radiographic_studies.asset_id
Ref: image_preflight_reviews.id < radiographic_studies.preflight_id
Ref: users.id < radiographic_studies.created_by
Ref: radiographic_studies.id < knee_observations.study_id [delete: cascade]
Ref: knee_observations.id < inference_jobs.observation_id [delete: cascade]
Ref: users.id < inference_jobs.created_by
Ref: inference_jobs.id - model_predictions.job_id
Ref: knee_observations.id < model_predictions.observation_id
Ref: users.id < model_predictions.created_by
Ref: model_predictions.id < gradcam_explanations.prediction_id [delete: cascade]
Ref: stored_assets.id < gradcam_explanations.asset_id
Ref: model_predictions.id < clinician_reviews.prediction_id
Ref: users.id < clinician_reviews.reviewed_by
Ref: knee_observations.id - clinical_observations.knee_observation_id [delete: cascade]
Ref: users.id < clinical_observations.recorded_by
Ref: patients.id < prior_exams.patient_id [delete: cascade]
Ref: users.id < prior_exams.recorded_by
Ref: clinical_episodes.id < draft_reports.episode_id
Ref: stored_assets.id < draft_reports.asset_id
Ref: users.id < draft_reports.generated_by
Ref: users.id < audit_events.actor_id
Ref: users.id < app_settings.updated_by
