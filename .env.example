# Entorno local. No confirmar .env ni secretos reales.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://oa_app:oa_dev_password@postgres:5432/oa_app
JWT_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-another-random-value
FIELD_ENCRYPTION_KEY=replace-with-field-base64-32-byte-key
BLIND_INDEX_KEY=replace-with-index-base64-32-byte-key
SERVICE_TOKEN=replace-with-a-long-random-service-token
ML_SERVICE_URL=http://ml-inference:8000
ASSET_ROOT=/data/assets
MODEL_ROOT=/models
MODEL_RELEASE=oa-final-2026-09-03
MODEL_PACKAGE_URL=
GH_MODELS_TOKEN=
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-bootstrap-password
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:3000
DEPLOYMENT_ENV=local
CLINICAL_PRODUCTION_APPROVED=false
